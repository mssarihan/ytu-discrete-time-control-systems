{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-pdf",
        "-pdflatex=pdflatex -include-directory=%WORKSPACE_FOLDER%/common %O %S",
        "-outdir=%OUTDIR%", "%DOC%"
      ],
      "env": {
        "TEXINPUTS": "%WORKSPACE_FOLDER%/common//;",
        "BIBINPUTS": "%WORKSPACE_FOLDER%/common//;",
        "BSTINPUTS": "%WORKSPACE_FOLDER%/common//;"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk", "tools": ["latexmk"] }
  ]
}
